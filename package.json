{
  "name": "note-workbench",
  "displayName": "Note Workbench — Obsidian-style Editor",
  "icon": "media/icon.png",
  "description": "Obsidian-style Markdown editing in VS Code with live preview, note graphs, editable tables, Markdown/HTML rendering and PDF export.",
  "version": "0.5.5",
  "publisher": "jiaque",
  "author": "jiaque",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiaque/note-workbench.git"
  },
  "homepage": "https://github.com/jiaque/note-workbench#readme",
  "bugs": {
    "url": "https://github.com/jiaque/note-workbench/issues"
  },
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "notes",
    "table",
    "obsidian",
    "live preview",
    "graph",
    "pdf"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "Note Workbench",
      "properties": {
        "noteWorkbench.render.motion.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "启用 CSS 动效和动态 SVG（默认开启，并尊重系统减少动态效果偏好）。关闭后保留静态内容和进度值；修改立即生效。"
        },
        "noteWorkbench.notes.newLocation": {
          "type": "string",
          "enum": [
            "current",
            "root",
            "folder"
          ],
          "default": "current",
          "scope": "resource",
          "description": "缺失笔记的创建目录：current 为当前笔记目录，root 为工作区根目录，folder 使用自定义目录。链接中明确指定路径时优先使用链接路径。"
        },
        "noteWorkbench.notes.newFolder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "新笔记自定义目录，相对于当前笔记库根目录。"
        },
        "noteWorkbench.render.remoteImages": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "允许加载 HTTPS 远程图片；关闭后仅允许笔记库内及 data 图片。适用于编辑、阅读、浮层和 PDF。修改后重新打开笔记生效。"
        },
        "noteWorkbench.pdf.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "restricted": true,
          "description": "PDF 导出使用的 Edge / Chrome 可执行文件路径。留空自动检测本机浏览器，无需安装 npm。"
        },
        "noteWorkbench.styleSheets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "笔记库内的 CSS 文件相对路径，按顺序应用到笔记视图。配合 YAML cssclasses 自定义展示。修改后重新打开笔记。"
        },
        "noteWorkbench.editor.blockPreview.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "编辑非表格块时，在其上方显示实时渲染浮层。离开后修改同步到文档，磁盘保存遵循 VS Code Auto Save 或 Ctrl+S。"
        },
        "noteWorkbench.graph.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "连接图包含的文件 glob；留空包含笔记库内全部 Markdown。"
        },
        "noteWorkbench.graph.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/{node_modules,.git,.npm-cache}/**"
          ],
          "description": "连接图排除的文件 glob。"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "noteWorkbench.editor",
        "displayName": "Note Workbench",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "noteWorkbench.exportPdf",
        "title": "Note Workbench: 导出 PDF"
      },
      {
        "command": "noteWorkbench.openEditor",
        "title": "Note Workbench: 打开笔记编辑器"
      },
      {
        "command": "noteWorkbench.openSource",
        "title": "Note Workbench: 打开源码"
      },
      {
        "command": "noteWorkbench.rebuildIndex",
        "title": "Note Workbench: 刷新连接图"
      },
      {
        "command": "noteWorkbench.openGraph",
        "title": "Note Workbench: 打开连接图"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "noteWorkbench.openEditor",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "noteWorkbench",
          "title": "Note Workbench",
          "icon": "media/graph.svg"
        }
      ]
    },
    "views": {
      "noteWorkbench": [
        {
          "type": "webview",
          "id": "noteWorkbench.graph",
          "name": "连接图"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:caret": "node scripts/test-caret.mjs",
    "test:motion": "node scripts/test-motion.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "npm run build && node scripts/licenses.mjs && vsce package --out artifacts/",
    "verify:package": "vsce ls --tree"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "css-tree": "3.2.1",
    "d3-force": "3.0.0",
    "hast-util-to-html": "9.0.5",
    "lucide": "0.577.0",
    "mermaid": "12.0.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.3.289",
    "refractor": "5.0.0",
    "rehype-mathjax": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.1",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@xmldom/xmldom": "0.9.12"
  }
}
